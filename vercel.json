{
  "functions": {
    "api/news.js": {
      "maxDuration": 15
    },
    "api/naver-list.js": {
      "maxDuration": 15
    },
    "api/bus-seats.js": {
      "maxDuration": 15
    },
    "api/forecast.js": {
      "maxDuration": 15
    }
  },
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/surfshare",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), payment=()"
        }
      ]
    },
    {
      "source": "/stats",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "regions": [
    "icn1"
  ]
}